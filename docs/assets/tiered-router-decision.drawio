<mxfile host="drawio" version="24.0.0"><diagram id="tiered-router-decision" name="tiered-router-decision"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="902" height="6" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="902" y="0" width="738" height="6" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Tiered router: Document Intelligence → Content Understanding → OCR&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=26;fontColor=#201F1E;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1560" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Escalate on a critical-field gate, not an average: one missing PO number is a human touch even if twelve fields are perfect." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=14;fontColor=#605E5C;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1560" height="28" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Incoming document&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;PDF / image&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="260" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Tier 1: Document Intelligence&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;prebuilt-invoice · fastest, lowest cost&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=document-intelligence;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="380" y="150" width="320" height="80" as="geometry"/></mxCell><mxCell id="c7" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="668" y="141" width="30" height="18" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;All critical fields present&lt;br&gt;and ≥ threshold?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="400" y="290" width="280" height="140" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;ACCEPT&lt;/b&gt;&lt;br&gt;post without review" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="800" y="325" width="220" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Tier 2: Content Understanding&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;custom analyzer · binds by meaning&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="380" y="500" width="320" height="80" as="geometry"/></mxCell><mxCell id="c11" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="668" y="491" width="30" height="18" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Critical fields resolved?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="400" y="630" width="280" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;ACCEPT&lt;/b&gt;&lt;br&gt;escalated + resolved" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="800" y="655" width="220" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Tier 3: prebuilt-read OCR&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;text only → human review queue&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=40;imageHeight=40;imageAlign=left;imageVerticalAlign=middle;spacingLeft=60;spacingRight=6;iconKey=document-intelligence;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="1100" y="640" width="300" height="90" as="geometry"/></mxCell><mxCell id="c15" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;