"0.0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#0078D4;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#107C10;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l24" value="yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;fontColor=#107C10;" connectable="0" vertex="1" parent="e23"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;strokeColor=#A4262C;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="800"/><mxPoint x="1250" y="800"/></Array></mxGeometry></mxCell><mxCell id="l26" value="no" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=#FFFFFF;fontFamily=Segoe UI;fontColor=#A4262C;" connectable="0" vertex="1" parent="e25"><mxGeometry x="0.0" y="0" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Critical fields (default)&lt;/b&gt;&lt;br&gt;VendorName · InvoiceId · InvoiceTotal · PurchaseOrder · InvoiceDate&lt;br&gt;&lt;br&gt;&lt;b&gt;Threshold&lt;/b&gt; 0.60 (CONFIDENCE_THRESHOLD)&lt;br&gt;Both are configuration, not code." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1100" y="150" width="500" height="190" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Strategies to compare&lt;/b&gt;&lt;br&gt;&lt;b&gt;di-only&lt;/b&gt; baseline: cheapest, misses the tail&lt;br&gt;&lt;b&gt;cu-only&lt;/b&gt; accuracy ceiling: every page pays the LLM tier&lt;br&gt;&lt;b&gt;cascade&lt;/b&gt; blended cost = DI + escalation rate × CU&lt;br&gt;&lt;br&gt;The escalation rate printed in every report decides the architecture." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1100" y="380" width="500" height="200" as="geometry"/></mxCell><mxCell id="c29" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF9F8;strokeColor=#C8C6C4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="716" height="40" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Legend&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=11;fontColor=#323130;" vertex="1" parent="1"><mxGeometry x="52" y="858" width="60" height="24" as="geometry"/></mxCell><mxCell id="c31" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="120" y="861" width="30" height="18" as="geometry"/></mxCell><mxCell id="c32" value="generally available" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#605E5C;" vertex="1" parent="1"><mxGeometry x="154" y="858" width="143" height="24" as="geometry"/></mxCell><mxCell id="c33" value="OPTIONAL" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#605E5C;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="307" y="861" width="78" height="18" as="geometry"/></mxCell><mxCell id="c34" value="alternative path / switchable" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#605E5C;" vertex="1" parent="1"><mxGeometry x="389" y="858" width="213" height="24" as="geometry"/></mxCell><mxCell id="c35" value="yes" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="612" y="861" width="40" height="18" as="geometry"/></mxCell><mxCell id="c36" value="no" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#CA5010;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="666" y="861" width="40" height="18" as="geometry"/></mxCell><mxCell id="c37" value="azure-di-vs-cu · 06-di-vs-cu-decision-guide | v1.1.0 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="1560" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
