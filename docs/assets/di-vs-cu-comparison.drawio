dth="143" height="24" as="geometry"/></mxCell><mxCell id="c32" value="invoice-extraction-di-vs-cu · 06-di-vs-cu-decision-guide / 07-use-case-comparison-chart | v1.1.0 | Icons: Microsoft Azure Architecture Icons (V24)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=10;fontColor=#8A8886;" vertex="1" parent="1"><mxGeometry x="40" y="926" width="1640" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
