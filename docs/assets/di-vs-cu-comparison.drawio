<mxfile host="drawio" version="24.0.0"><diagram id="di-vs-cu-comparison" name="di-vs-cu-comparison"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="960" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="" style="rounded=0;fillColor=#0078D4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="946" height="6" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=0;fillColor=#5C2D91;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="946" y="0" width="774" height="6" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Same invoice, two binding strategies&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=26;fontColor=#201F1E;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1640" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Document Intelligence locates fields by learned layout; Content Understanding reasons over a schema you describe. The difference shows up when the template moves." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=14;fontColor=#605E5C;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1640" height="28" as="geometry"/></mxCell><mxCell id="c5" value="Document Intelligence (prebuilt-invoice)" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#0078D4;spacingTop=8;fontFamily=Segoe UI;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=document-intelligence;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="760" height="700" as="geometry"/></mxCell><mxCell id="c6" value="Content Understanding (custom analyzer)" style="shape=label;rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F0FA;strokeColor=#5C2D91;strokeWidth=1.5;verticalAlign=top;align=left;fontStyle=1;fontSize=14;fontColor=#5C2D91;spacingTop=8;fontFamily=Segoe UI;imageWidth=28;imageHeight=28;imageAlign=left;imageVerticalAlign=top;spacingLeft=46;iconKey=foundry;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="920" y="120" width="760" height="700" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Define output&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Pick a prebuilt model (or label + train a custom one)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="720" height="80" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Define output&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Write a field schema in plain language (or start from prebuilt-invoice)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=gear;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="940" y="180" width="720" height="80" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;vs&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="816" y="202" width="88" height="36" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Bind fields&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Learned layout + label position&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=code;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="284" width="720" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Bind fields&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Meaning + context of the whole document&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=code;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="940" y="284" width="720" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;vs&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="816" y="306" width="88" height="36" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Known template&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Excellent, fastest, cheapest&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="388" width="720" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Known template&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Very good; you pay for reasoning you don't use&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="940" y="388" width="720" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;vs&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="816" y="410" width="88" height="36" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Vendor revises template&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Breaks on the changed regions (partial, silent)&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=media-file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="492" width="720" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Vendor revises template&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Survives relabels, moved blocks, extra columns&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=media-file;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="940" y="492" width="720" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;gap&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="816" y="514" width="88" height="36" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Inferred values&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;None: located spans only&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="596" width="720" height="80" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Inferred values&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;generate / classify: currency, document kind, risk summary&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=toolbox;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="940" y="596" width="720" height="80" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;vs&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="816" y="618" width="88" height="36" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Confidence&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;On every located field&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="720" height="80" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Confidence&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#605E5C&quot;&gt;Opt-in (estimateFieldSourceAndConfidence), all field types, different calibration&lt;/font&gt;" style="shape=label;rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C2D91;strokeWidth=1.5;fontSize=12;fontColor=#201F1E;fontFamily=Segoe UI;align=left;verticalAlign=middle;imageWidth=36;imageHeight=36;imageAlign=left;imageVerticalAlign=middle;spacingLeft=56;spacingRight=6;iconKey=keys;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="940" y="700" width="720" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;vs&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;strokeWidth=1.5;fontSize=11;fontColor=#201F1E;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="816" y="722" width="88" height="36" as="geometry"/></mxCell><mxCell id="c25" value="GA" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;fillColor=#107C10;strokeColor=#FFFFFF;strokeWidth=1.5;fontColor=#FFFFFF;fontStyle=1;fontSize=9;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometr